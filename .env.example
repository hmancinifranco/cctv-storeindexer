# =============================================================================
# .env.example  --  COMMITTED template. Copy to .env and fill real values.
#   cp .env.example .env
# .env is git-ignored; never commit real account values, ARNs, or CIDRs.
# =============================================================================

# --- Deployment target ---
# Named AWS CLI v2 profile created beforehand with one of:
#   aws login --profile <name>           (recommended for console IAM/federation; CLI 2.32+),
#   aws configure sso --profile <name>   (IAM Identity Center), or
#   aws configure --profile <name>       (last-resort long-term IAM access keys).
# Store only the profile name here, never access keys.
AWS_PROFILE=<your-aws-profile>

# Region. Keep us-east-1 for the demo (CloudFront WAF requirement) unless data
# residency requires otherwise (e.g. sa-east-1).
AWS_REGION=us-east-1

# --- Project / stack naming ---
PROJECT_NAME=cctv-storeindexer
STACK_NAME=cctv-storeindexer-demo
ENVIRONMENT=demo

# --- Network access control (fail-closed) ---
# IP_ALLOWLIST_MODE: "enforce" (default, production) requires OFFICE_ALLOWED_CIDRS
# and fails closed if empty. "disabled" = explicit demo opt-out (Cognito still applies).
IP_ALLOWLIST_MODE=enforce
# Comma-separated public office CIDR(s). Required when mode=enforce; empty fails closed.
OFFICE_ALLOWED_CIDRS=

# --- S3 ---
VIDEO_BUCKET_NAME=
# Key prefix under which recordings are uploaded.
INGEST_PREFIX=videos

# --- Retention lifecycle (applied at deploy) ---
# RETENTION_MODE: "expire" = auto-delete objects RETENTION_DAYS after creation.
#                 "keep"   = no automatic deletion (safe customer default).
# Keep data until the customer explicitly approves a lifecycle. When expire is
# approved, 90 days is the current planning target; the final lifecycle/class is
# chosen from pilot measurements and recovery SLA.
RETENTION_MODE=keep
RETENTION_DAYS=90
# Deleted catalog entries are retained for audit, then removed asynchronously by DynamoDB TTL.
CATALOG_TOMBSTONE_RETENTION_DAYS=365
# Pilot storage class is S3 Standard. Rollout may use Standard-IA or a Glacier
# class only after cost/recovery validation; this variable is currently
# documentation-only and does not configure transitions by itself.
STORAGE_CLASS=STANDARD

# --- PoC on-premises uploader credentials ---
# Existing technical IAM user. The stack grants this user ONLY sts:AssumeRole
# on the scoped uploader role; it never creates or outputs access keys.
UPLOADER_IAM_USER_NAME=
# Roadmap: replace the long-lived source key with certificate-based temporary
# credentials. Leave false for the simplified PoC.
ROLES_ANYWHERE_ENABLED=false
RA_TRUST_ANCHOR_ARN=
RA_PROFILE_ARN=
RA_ROLE_ARN=

# --- Deployed stack outputs (RUNTIME; filled from describe-stacks after deploy) ---
# Read by the app/uploader. Keep separate from VIDEO_BUCKET_NAME (naming param).
VIDEO_BUCKET_RESOLVED=
SPA_BUCKET_RESOLVED=
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
CLOUDFRONT_URL=
CLOUDFRONT_DISTRIBUTION_ID=
COGNITO_HOSTED_UI_DOMAIN=
UPLOADER_ROLE_ARN=
