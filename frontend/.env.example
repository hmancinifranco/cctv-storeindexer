# Frontend build-time config (Vite exposes VITE_* to the browser).
# Copy to .env.local for local dev. Do NOT put secrets here — these ship to the client.
VITE_API_BASE=https://REPLACE.execute-api.us-east-1.amazonaws.com/v1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Local-dev only: paste a short-lived Cognito ID token to exercise the API
# before the hosted-UI login (T6.3) exists. Never commit a real token.
VITE_DEV_ID_TOKEN=
